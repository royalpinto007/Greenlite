{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "greenlite",
  "account_id": "a97af859ae0c177338e4df0b1d640176",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-25",
  // dist/ holds the marketing site at the root and the Expo web app under
  // dist/app (see build:web). The Worker in src/index.ts routes between them.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "observability": { "enabled": true }
}
